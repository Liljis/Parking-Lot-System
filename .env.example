# Server Configuration
PORT=5001
HOST=127.0.0.1
NODE_ENV=development
CLIENT_URL=http://127.0.0.1:3000

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/parking_lot

# Session Security
SESSION_SECRET=replace-with-a-secure-random-secret-key-min-32-chars

# w3id OpenID Connect (OIDC)
OIDC_ISSUER=https://preprod.w3id.sso.ibm.com/isam/oidc/endpoint/amapp-runtime-oidcidp
OIDC_CLIENT_ID=your-oidc-client-id
OIDC_CLIENT_SECRET=your-oidc-client-secret
OIDC_CALLBACK_URL=http://127.0.0.1:5001/auth/callback

# Dev Auth Mock Mode (Set true for local dev testing without live w3id IdP)
DEV_AUTH_ENABLED=true

# Parking Lot Geolocation Boundary
PARKING_LOT_NAME=HQ Tech Park - Lot A
PARKING_LOT_LAT=37.774929
PARKING_LOT_LNG=-122.419416
PARKING_LOT_RADIUS_METERS=150
